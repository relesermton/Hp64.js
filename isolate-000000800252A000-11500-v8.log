; replVal.length = 0;\n\n  const IMPORT_EXPORT_TYPE = 1;\n  const DECL = 2;\n  const ABSTRACT_CLASS = 3;\n  const IMPLEMENTS = 5;\n  const PARAMS = 6;\n  const RETURN_OR_VAR = 7;\n  const AS = 8;\n  const NOTNULL = 9;\n  const MODIFIER = 10;\n  const OPT_MEMBER = 11;\n  const IMPORT_EXPORT_BRACES = 12;\n  const MEMBER_TYPE = 13;\n\n  // pass 1: classify + mark deletions\n  const classStack = []; // {end\x2C memberSd} of open class bodies\n  for (let i = 0; i < n; i++) {\n    if (del[i]) continue;\n    const v = tv[i]\x2C tk = tt[i];\n\n    while (classStack.length && classStack[classStack.length - 1].end < i) classStack.pop();\n    let memberPos = false;\n    if (classStack.length) {\n      const top = classStack[classStack.length - 1];\n      memberPos = sd[i] === top.memberSd;\n    }\n    // class declarations: remember body extent for member-position checks\n    if (tk === T_ID && v === K.class && (i === 0 || tv[i - 1] !== C_DOT)) {\n      const nx = i + 1 < n ? i + 1 : -1;\n      if (nx >= 0 && (tt[nx] === T_ID || tv[nx] === C_LBR)) {\n        const b = findClassBody(T\x2C i);\n        if (b >= 0 && closeArr[b] >= 0) classStack.push({ end: closeArr[b]\x2C memberSd: sd[b] + 1 });\n      }\n    }\n\n    // import/export statements: handle wholesale (also protects `as` aliases).\n    // Partition by token kind first: only keyword ids match the word branches\x2C\n    // only punctuators the symbol branches \u2014 plain identifiers/literals skip\n    // the entire chain (they can never classify).\n    let kind = 0;\n    if (tk === T_ID && v >= 256) {\n      if (v === K.import || v === K.export) {\n        const nx = i + 1 < n ? i + 1 : -1;\n        if (nx >= 0 && tv[nx] === K.type) kind = IMPORT_EXPORT_TYPE;\n        else if (nx >= 0 && tv[nx] === C_LBR) kind = IMPORT_EXPORT_BRACES;\n      }\n      else if (TSF[v]) {\n        // statement start\x2C possibly preceded by export/declare (and const for `const enum`)\n        let k = i - 1;\n        while (k >= 0) {\n          const pv = tv[k];\n          if (pv === K.export || pv === K.declare || (v === K.enum && pv === K.const)) k--;\n          else break;\n        }\n        const nx = i + 1 < n ? i + 1 : -1;\n        if (nx >= 0 && tt[nx] === T_ID &&\n            (k < 0 || tv[k] === C_SEMI || tv[k] === C_LBR || tv[k] === C_RBR || tt[k] === T_EOF)) kind = DECL;\n      }\n      else if (v === K.abstract && i + 1 < n && tv[i + 1] === K.class) kind = ABSTRACT_CLASS;\n      else if (v === K.implements) kind = IMPLEMENTS;\n      else if (v === K.as || v === K.satisfies) {\n        const bi = i - 1;\n        if (bi >= 0) {\n          const bt = tt[bi]\x2C bv = tv[bi];\n          if (bt === T_ID || bv === C_RP || bv === C_RB || bv === C_RBR || bv === C_GT ||\n              bv === C_BANG || bt === T_NUM || bt === T_STR || bt === T_TPL ||\n              bv === K.this || bv === K.super) {\n            const bkw = bt === T_ID ? bv : 0;\n            if (!(bkw === K.import || bkw === K.export || bkw === K.from)) kind = AS;\n          }\n        }\n      }\n      else if (MODWF[v]) {\n        const bi = i - 1\x2C ni = i + 1;\n        const memberStart = bi < 0 || tv[bi] === C_LBR || tv[bi] === C_SEMI || tv[bi] === C_RBR ||\n          (tt[bi] === T_ID && MODWF[tv[bi]]);\n        if (memberStart && ni < n && (tt[ni] === T_ID || tv[ni] === C_STAR || tv[ni] === C_HASH || tv[ni] === C_LB)) kind = MODIFIER;\n      }\n    }\n    else if (tk === T_P) {\n      if (v === C_LP) {\n        const close = closeArr[i];\n        if (close >= 0 && isParamList(T\x2C i\x2C close\x2C closeArr\x2C paramFlag\x2C openOf)) kind = PARAMS;\n      }\n      else if (v === C_COLON) {\n        const pi = i - 1;\n        if (pi >= 0 && (tv[pi] === C_RP || tv[pi] === C_GT)) {\n          if (!isTernaryBefore(T\x2C i\x2C del\x2C openOf)) kind = RETURN_OR_VAR;\n        }\n        else if (pi >= 0 && tt[pi] === T_ID && !KEYF[tv[pi]]) {\n          const bi = i - 2;\n          if (bi >= 0 && (tv[bi] === K.let || tv[bi] === K.const || tv[bi] === K.var)) kind = RETURN_OR_VAR;\n          else if (bi >= 0 && tv[bi] === C_COMMA && isVarDeclBefore(T\x2C i\x2C del\x2C openOf)) kind = RETURN_OR_VAR; // `let a: T = 1\x2C b: U`\n          else if (memberPos && memberBoundaryOk(T\x2C i\x2C openOf)) kind = MEMBER_TYPE;\n        }\n        else if (memberPos && pi >= 0 && (tt[pi] === T_ID || tv[pi] === C_QMARK || tv[pi] === C_RB) &&\n                 memberBoundaryOk(T\x2C i\x2C openOf)) kind = MEMBER_TYPE;\n      }\n      else if (v === C_BANG) {\n        const bi = i - 1\x2C ni = i + 1;\n        if (bi >= 0 && ni < n) {\n          const bt = tt[bi]\x2C bv = tv[bi]\x2C at = tt[ni]\x2C av = tv[ni];\n          if ((bt === T_ID || bv === C_RP || bv === C_RB || bt === T_NUM ||\n               bt === T_STR || bt === T_TPL || bv === K.this) &&\n              (av === C_DOT || av === C_LB || av === C_LP || av === C_SEMI || av === C_RP ||\n               av === C_COMMA || av === C_RBR || av === C_COLON || av === C_EQ || av === C_QMARK ||\n               at === T_EOF || at === T_ID || av === C_BANG || av === C_PLUS)) kind = NOTNULL;\n        }\n      }\n      else if (v === C_QMARK) {\n        const pi = i - 1\x2C ni = i + 1;\n        if (pi >= 0 && tt[pi] === T_ID && ni < n &&\n            (tv[ni] === C_COLON || tv[ni] === C_SEMI ||\n             (tv[ni] === C_LP && memberPos && memberBoundaryOk(T\x2C i\x2C openOf)))) kind = OPT_MEMBER;\n      }\n    }\n\n    switch (kind) {\n      case IMPORT_EXPORT_TYPE: {\n        const nx = i + 1 < n ? i + 1 : -1;\n        const isBraces = tv[nx] === C_LBR || (i + 2 < n && tv[i + 2] === C_LBR);\n        const end = isBraces ? impExpEnd(T\x2C i\x2C closeArr) : stmtEnd(T\x2C i);\n        for (let k = i; k <= end; k++) del[k] = 1;\n        i = end;\n        break;\n      }\n      case IMPORT_EXPORT_BRACES: {\n        // `import { type A\x2C B } from` / `export { type A\x2C B }` \u2014 strip type-only\n        // specifiers; jump past the statement so `as` aliases are never re-classified.\n        const bOpen = tv[i + 1] === C_LBR ? i + 1 : i + 2;\n        const close = closeArr[bOpen];\n        if (close >= 0) {\n          for (let k = bOpen + 1; k < close; k++) {\n            if (tt[k] === T_ID && tv[k] === K.type) {\n              const nx = k + 1 < n ? k + 1 : -1\x2C nx2 = k + 2 < n ? k + 2 : -1;\n              if (nx >= 0 && tt[nx] === T_ID && nx2 >= 0 && (tv[nx2] === C_COMMA || tv[nx2] === C_RBR)) {\n                del[k] = 1;\n                del[k + 1] = 1;\n                if (tv[nx2] === C_COMMA) { del[k + 2] = 1; k += 2; }\n                else if (tv[k - 1] === C_COMMA) del[k - 1] = 1;\n              }\n            }\n          }\n        }\n        i = impExpEnd(T\x2C i\x2C closeArr);\n        break;\n      }\n      case DECL:\n        stripDeclaration(T\x2C i\x2C del\x2C closeArr\x2C replIdx\x2C replVal);\n        break;\n      case ABSTRACT_CLASS:\n        del[i] = 1;\n        break;\n      case IMPLEMENTS: {\n        let j = i;\n        while (j < n && tv[j] !== C_LBR) j++;\n        for (let k = i; k < j; k++) del[k] = 1;\n        i = j - 1;\n        break;\n      }\n      case PARAMS: {\n        const close = closeArr[i];\n        let depth = 0;\n        for (let j = i + 1; j < close; j++) {\n          const pv = tv[j];\n          if (pv === C_LP || pv === C_LB || pv === C_LBR) depth++;\n          else if (pv === C_RP || pv === C_RB || pv === C_RBR) depth--;\n          else if (depth === 0) {\n            if (pv === C_COLON) {\n              const end = markType(T\x2C j\x2C STOP_PARAM\x2C del\x2C partial);\n              j = end;\n            } else if (pv === C_QMARK) {\n              const nx = j + 1 < n ? j + 1 : -1;\n              if (nx >= 0 && (tv[nx] === C_COLON || tv[nx] === C_RP)) del[j] = 1;\n            } else if (MODWF[pv]) {\n              const nx = j + 1 < n ? j + 1 : -1;\n              if (nx >= 0 && tt[nx] === T_ID) del[j] = 1;\n            }\n          }\n        }\n        break;\n      }\n      case RETURN_OR_VAR: {\n        const pi = i - 1;\n        const isReturn = pi >= 0 && (tv[pi] === C_RP || tv[pi] === C_GT);\n        const end = markType(T\x2C i\x2C isReturn ? STOP_RETURN : STOP_VAR\x2C del\x2C partial);\n        // bodyless signature: `m(): void;` / `function f(a): T;` \u2014 the whole\n        // statement is TS-only (overload / abstract member / interface-style sig)\n        if (isReturn && end + 1 < n && tv[end + 1] === C_SEMI) {\n          const start = sigStart(T\x2C i - 1\x2C openOf);\n          if (start >= 0) {\n            for (let k = start; k <= end + 1; k++) del[k] = 1;\n            i = end + 1;\n            break;\n          }\n        }\n        i = end;\n        break;\n      }\n      case MEMBER_TYPE: {\n        const end = markType(T\x2C i\x2C STOP_MEMBER\x2C del\x2C partial);\n        i = end;\n        break;\n      }\n      case AS: {\n        const end = markType(T\x2C i\x2C STOP_AS\x2C del\x2C partial);\n        i = end;\n        break;\n      }\n      case NOTNULL:\n      case MODIFIER:\n      case OPT_MEMBER:\n        del[i] = 1;\n        break;\n    }\n  }\n\n  // fast path: nothing removed\n  let anyDel = false;\n  for (let i = 0; i < n; i++) if (del[i]) { anyDel = true; break; }\n  if (!anyDel) return { code: src\x2C stats: { tokens: n\x2C removed: 0 } };\n\n  // pass 2: emit\x2C cutting deleted ranges\x2C applying replacements.\n  // Runs of consecutive deleted tokens are collapsed into one position jump\n  // (one slice per run instead of one per token).\n  let out = "";\n  let pos = 0\x2C rp = 0;\n  for (let i = 0; i < n; i++) {\n    if (rp < replIdx.length && replIdx[rp] === i) {\n      if (ts[i] > pos) out += src.slice(pos\x2C ts[i]);\n      out += replVal[rp];\n      pos = te[i];\n      rp++;\n      while (i + 1 < n && del[i + 1]) { i++; pos = te[i]; }\n    } else if (del[i]) {\n      if (ts[i] < pos) continue;\n      if (ts[i] > pos) out += src.slice(pos\x2C ts[i]);\n      // extend over the whole run of deleted tokens (r