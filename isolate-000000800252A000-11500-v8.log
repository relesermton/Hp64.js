o `path.join(os.tmpdir()\x2C 'node-compile-cache')`.\x0d\n * @param {string | { directory?: string\x2C portable?: boolean\x2C readOnly?: boolean } | undefined} options\x0d\n * @returns {{status: number\x2C message?: string\x2C directory?: string}}\x0d\n */\x0d\nfunction enableCompileCache(options) {\x0d\n  let portable;\x0d\n  let readOnly;\x0d\n  let directory;\x0d\n\x0d\n  if (typeof options === 'object' && options !== null) {\x0d\n    ({ directory\x2C portable\x2C readOnly } = options);\x0d\n  } else {\x0d\n    directory = options;\x0d\n  }\x0d\n  if (directory === undefined) {\x0d\n    directory = process.env.NODE_COMPILE_CACHE || join(lazyTmpdir()\x2C 'node-compile-cache');\x0d\n  }\x0d\n  if (portable === undefined) {\x0d\n    portable = process.env.NODE_COMPILE_CACHE_PORTABLE === '1';\x0d\n  }\x0d\n  if (readOnly === undefined) {\x0d\n    readOnly = process.env.NODE_COMPILE_CACHE_READONLY === '1';\x0d\n  }\x0d\n  const nativeResult = _enableCompileCache(directory\x2C portable\x2C readOnly);\x0d\n  const result = { status: nativeResult[0] };\x0d\n  if (nativeResult[1]) {\x0d\n    result.message = nativeResult[1];\x0d\n  }\x0d\n  if (nativeResult[2]) {\x0d\n    result.directory = nativeResult[2];\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\nconst compileCacheStatus = { __proto__: null };\x0d\nfor (let i = 0; i < _compileCacheStatus.length; ++i) {\x0d\n  compileCacheStatus[_compileCacheStatus[i]] = i;\x0d\n}\x0d\nObjectFreeze(compileCacheStatus);\x0d\nconst constants = { __proto__: null\x2C compileCacheStatus };\x0d\nObjectFreeze(constants);\x0d\n\x0d\n/**\x0d\n * Get the compile cache directory if on-disk compile cache is enabled.\x0d\n * @returns {string|undefined} Path to the module compile cache directory if it is enabled\x2C\x0d\n *   or undefined otherwise.\x0d\n */\x0d\nfunction getCompileCacheDir() {\x0d\n  return _getCompileCacheDir() || undefined;\x0d\n}\x0d\n\x0d\nfunction getRequireStack(parent) {\x0d\n  const requireStack = [];\x0d\n  for (let c