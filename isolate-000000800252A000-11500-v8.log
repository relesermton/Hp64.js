script-source,49,node:internal/modules/helpers,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeForEach\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  MapPrototypeForEach\x2C\x0d\n  MapPrototypeGet\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectFreeze\x2C\x0d\n  ObjectKeys\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ReflectApply\x2C\x0d\n  SafeMap\x2C\x0d\n  SafeSet\x2C\x0d\n  StringPrototypeCharCodeAt\x2C\x0d\n  StringPrototypeIncludes\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\nconst {\x0d\n  ERR_INVALID_ARG_TYPE\x2C\x0d\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\x0d\n  ERR_UNKNOWN_BUILTIN_MODULE\x2C\x0d\n} = require('internal/errors').codes;\x0d\nconst { BuiltinModule } = require('internal/bootstrap/realm');\x0d\n\x0d\nconst { validateString } = require('internal/validators');\x0d\nconst fs = require('fs'); // Import all of `fs` so that it can be monkey-patched.\x0d\nconst internalFS = require('internal/fs/utils');\x0d\nconst path = require('path');\x0d\nconst { pathToFileURL\x2C fileURLToPath\x2C URL } = require('internal/url');\x0d\nconst assert = require('internal/assert');\x0d\n\x0d\nconst { getOptionValue } = require('internal/options');\x0d\nconst { kEmptyObject\x2C setOwnProperty\x2C getLazy } = require('internal/util');\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst { emitWarningSync } = require('internal/process/warning');\x0d\nconst {\x0d\n  privateSymbols: {\x0d\n    module_first_parent_private_symbol: kFirstModuleParent\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('util');\x0d\nconst lazyTmpdir = getLazy(() => require('os').tmpdir());\x0d\nconst { join } = path;\x0d\n\x0d\nconst internalFsBinding = internalBinding('fs');\x0d\nconst { canParse: URLCanParse } = internalBinding('url');\x0d\nconst modulesBinding = internalBinding('modules');\x0d\nconst {\x0d\n  enableCompileCache: _enableCompileCache\x2C\x0d\n  getCompileCacheDir: _getCompileCacheDir\x2C\x0d\n  compileCacheStatus: _compileCacheStatus\x2C\x0d\n  flushCompileCache\x2C\x0d\n} = modulesBinding;\x0d\n\x0d\nconst lazyCJSLoader = getLazy(() => require('internal/modules/cjs/loader'));\x0d\nlet debug = require('internal/util/debuglog').debuglog('module'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\n\x0d\n/** @typedef {import('internal/modules/cjs/loader.js').Module} Module */\x0d\n\x0d\n/**\x0d\n * Cache for storing resolved real paths of modules.\x0d\n * In order to minimize unnecessary lstat() calls\x2C this cache is a list of known-real paths.\x0d\n * Set to an empty Map to reset.\x0d\n * @type {Map<string\x2C string>}\x0d\n */\x0d\nconst realpathCache = new SafeMap();\x0d\n\x0d\n// Toggleable loader hooks for VFS support. Overrides that return\x0d\n// `undefined` fall through to the pinned native implementation.\x0d\nconst nativeLoaderMethods = {\x0d\n  internalModuleStat: (filename) => internalFsBinding.internalModuleStat(filename)\x2C\x0d\n  readFileSync: (filename\x2C options) => fs.readFileSync(filename\x2C options)\x2C\x0d\n  realpathSync: (requestPath) => fs.realpathSync(requestPath\x2C {\x0d\n    [internalFS.realpathCacheKey]: realpathCache\x2C\x0d\n  })\x2C\x0d\n  legacyMainResolve: (pkgPath\x2C main\x2C base) =>\x0d\n    internalFsBinding.legacyMainResolve(pkgPath\x2C main\x2C base)\x2C\x0d\n  getFormatOfExtensionlessFile: (filePath) =>\x0d\n    internalFsBinding.getFormatOfExtensionlessFile(filePath)\x2C\x0d\n  readPackageJSON: (jsonPath\x2C isESM\x2C base\x2C specifier) =>\x0d\n    modulesBinding.readPackageJSON(jsonPath\x2C isESM\x2C base\x2C specifier)\x2C\x0d\n  getNearestParentPackageJSON: (checkPath) =>\x0d\n    modulesBinding.getNearestParentPackageJSON(checkPath)\x2C\x0d\n  getNearestParentPackageJSONType: (checkPath) =>\x0d\n    modulesBinding.getNearestParentPackageJSONType(checkPath)\x2C\x0d\n  getPackageScopeConfig: (resolved) =>\x0d\n    modulesBinding.getPackageScopeConfig(resolved)\x2C\x0d\n  getPackageType: (url) => modulesBinding.getPackageType(url)\x2C\x0d\n  // Synthetic hook with no native counterpart: returns the directory at\x0d\n  // which upward walks (node_modules lookups) must stop for `path`\x2C or\x0d\n  // undefined to walk to the file system root.\x0d\n  getResolutionRoot: () => undefined\x2C\x0d\n};\x0d\nconst loaderMethodKeys = ObjectKeys(nativeLoaderMethods);\x0d\n// Overrides use this sentinel when they handled a request but their method's\x0d\n// meaningful result is `undefined`. A plain `undefined` means fall through to\x0d\n// the native implementation.\x0d\nconst kLoaderOverrideNoResult = Symbol('kLoaderOverrideNoResult');\x0d\nconst loaderOverrides = new SafeMap();\x0d\nlet hasLoaderOverrides = false;\x0d\n\x0d\n/**\x0d\n * @param {string} key Name of the wrapped method in `nativeLoaderMethods`.\x0d\n * @param {Function} originalFn Native fallback pinned at load time.\x0d\n * @returns {Function} Wrapper that consults `loaderOverrides` and falls\x0d\n *   through to `originalFn` when no override is set or when the\x0d\n *   override returns `undefined`.\x0d\n */\x0d\nfunction wrapLoaderMethod(key\x2C originalFn) {\x0d\n  return function loaderMethodWrapper(...args) {\x0d\n    if (hasLoaderOverrides) {\x0d\n      const override = MapPrototypeGet(loaderOverrides\x2C key);\x0d\n      if (override !== undefined) {\x0d\n        const result = ReflectApply(override\x2C undefined\x2C args);\x0d\n        if (result === kLoaderOverrideNoResult) { return undefined; }\x0d\n        if (result !== undefined) { return result; }\x0d\n      }\x0d\n    }\x0d\n    return ReflectApply(originalFn\x2C undefined\x2C args);\x0d\n  };\x0d\n}\x0d\n\x0d\n/**\x0d\n * Toggleable versions of the loader's fs and package.json methods\x2C keyed\x0d\n * like `nativeLoaderMethods`. The module loader calls these instead of the\x0d\n * native implementations so that VFS overrides can be consulted first.\x0d\n */\x0d\nconst loaderMethods = { __proto__: null };\x0d\nfor (let i = 0; i < loaderMethodKeys.length; i++) {\x0d\n  const key = loaderMethodKeys[i];\x0d\n  loaderMethods[key] = wrapLoaderMethod(key\x2C nativeLoaderMethods[key]);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Set override functions for the module loader's fs and package.json\x0d\n * operations. Fields are keyed like `nativeLoaderMethods`; missing or\x0d\n * nullish fields disable that hook (fast-path restored).\x0d\n * @param {Record<string\x2C Function|undefined>} overrides\x0d\n */\x0d\nfunction setLoaderOverrides(overrides = kEmptyObject) {\x0d\n  for (let i = 0; i < loaderMethodKeys.length; i++) {\x0d\n    const key = loaderMethodKeys[i];\x0d\n    const override = overrides[key];\x0d\n    if (override) {\x0d\n      loaderOverrides.set(key\x2C override);\x0d\n    } else {\x0d\n      loaderOverrides.delete(key);\x0d\n    }\x0d\n  }\x0d\n  hasLoaderOverrides = loaderOverrides.size > 0;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Delete every entry in `cache` whose owned string is under\x0d\n * `mountPoint`. `cache` is either a plain object (Module._cache\x2C\x0d\n * Module._pathCache) or a SafeMap (statCache\x2C realpathCache\x2C\x0d\n * the package.json caches). By default the entry KEY is tested;\x0d\n * pass `byValue: true` to test the entry value instead (used for\x0d\n * Module._pathCache whose keys are `request\\0parent` tokens and\x0d\n * whose values are the resolved filenames).\x0d\n *\x0d\n * Mount points live in the reserved VFS namespace so a prefix scan\x0d\n * on strings is exact - real-fs entries never match.\x0d\n * @param {object|Map<string\x2C *>} cache\x0d\n * @param {string} mountPoint Absolute mount-point path\x0d\n * @param {boolean} [byValue] Test the entry value instead of the key\x0d\n */\x0d\nfunction cleanForVfsPrefix(cache\x2C mountPoint\x2C byValue = false) {\x0d\n  const prefix = mountPoint + path.sep;\x0d\n  const owns = (s) =>\x0d\n    typeof s === 'string' &&\x0d\n    (s === mountPoint || StringPrototypeStartsWith(s\x2C prefix));\x0d\n  if (typeof cache.forEach === 'function') {\x0d\n    MapPrototypeForEach(cache\x2C (v\x2C k) => {\x0d\n      if (owns(byValue ? v : k)) { cache.delete(k); }\x0d\n    });\x0d\n  } else {\x0d\n    ArrayPrototypeForEach(ObjectKeys(cache)\x2C (k) => {\x0d\n      if (owns(byValue ? cache[k] : k)) { delete cache[k]; }\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Drop realpath-cache entries under an unmounted VFS mount point.\x0d\n * Called by internal/vfs/setup.js.\x0d\n * @param {string} mountPoint Absolute mount-point path\x0d\n */\x0d\nfunction purgeRealpathCacheForPrefix(mountPoint) {\x0d\n  cleanForVfsPrefix(realpathCache\x2C mountPoint);\x0d\n}\x0d\n\x0d\n/** @type {Set<string>} */\x0d\nlet cjsConditions;\x0d\n/** @type {string[]} */\x0d\nlet cjsConditionsArray;\x0d\n\x0d\n/**\x0d\n * Define the conditions that apply to the CommonJS loader.\x0d\n * @returns {void}\x0d\n */\x0d\nfunction initializeCjsConditions() {\x0d\n  const userConditions = getOptionValue('--conditions');\x0d\n  const noAddons = getOptionValue('--no-addons');\x0d\n  const addonConditions = noAddons ? [] : ['node-addons'];\x0d\n  // TODO: Use this set when resolving pkg#exports conditions in loader.js.\x0d\n  cjsConditionsArray = [\x0d\n    'require'\x2C\x0d\n    'node'\x2C\x0d\n    ...addonConditions\x2C\x0d\n    ...userConditions\x2C\x0d\n  ];\x0d\n  if (getOptionValue('--require-module')) {\x0d\n    cjsConditionsArray.push('module-sync');\x0d\n  }\x0d\n  ObjectFreeze(cjsConditionsArray);\x0d\n  cjsConditions = new SafeSet(cjsConditionsArray);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Get the conditions that apply to the CommonJS loader.\x0d\n * @returns {Set<string>}\x0d\n */\x0d\nfunction getCjsConditions() {\x0d\n  if (cjsConditions === undefined) {\x0d\n    initializeCjsConditions();\x0d\n  }\x0d\n  return cjsConditions;\x0d\n}\x0d\n\x0d\nfunction getCjsConditionsArray() {\x0d\n  if (cjsConditionsArray === undefined) {\x0d\n    initializeCjsConditions();\x0d\n  }\x0d\n  return cjsConditionsArray;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Provide one of Node.js' public modules to user code.\x0d\n * @param {string} id - The identifier/specifier of the builtin module to load\x0d\n * @returns {object|undefined}\x0d\n */\x0d\nfunction loadBuiltinModule(id) {\x0d\n  if (!BuiltinModule.canBeRequiredByUsers(id)) {\x0d\n    return;\x0d\n  }\x0d\n  /** @type {import('internal/bootstrap/realm.js').BuiltinModule} */\x0d\n  const mod = BuiltinModule.map.get(id);\x0d\n  debug('load built-in module %s'\x2C id);\x0d\n  // compileForPublicLoader() throws if canBeRequiredByUsers is false:\x0d\n  mod.compileForPublicLoader();\x0d\n  return mod;\x0d\n}\x0d\n\x0d\nlet isSEABuiltinWarningNeeded_;\x0d\nfunction isSEABuiltinWarningNeeded() {\x0d\n  if (isSEABuiltinWarningNeeded_ === undefined) {\x0d\n    const { isExperimentalSeaWarningNeeded\x2C isSea } = internalBinding('sea');\x0d\n    isSEABuiltinWarningNeeded_ = isSea() && isExperimentalSeaWarningNeeded();\x0d\n  }\x0d\n  return isSEABuiltinWarningNeeded_;\x0d\n}\x0d\n\x0d\nlet warnedAboutBuiltins = false;\x0d\n/**\x0d\n * Helpers to load built-in modules for embedder modules.\x0d\n * @param {string} id\x0d\n * @returns {import('internal/bootstrap/realm.js').BuiltinModule}\x0d\n */\x0d\nfunction loadBuiltinModuleForEmbedder(id) {\x0d\n  const normalized = BuiltinModule.normalizeRequirableId(id);\x0d\n  if (normalized) {\x0d\n    const mod = loadBuiltinModule(normalized);\x0d\n    if (mod) {\x0d\n      return mod;\x0d\n    }\x0d\n  }\x0d\n  if (isSEABuiltinWarningNeeded() && !warnedAboutBuiltins) {\x0d\n    emitWarningSync(\x0d\n      'Currently the require() provided to the main script embedded into ' +\x0d\n      'single-executable applications only supports loading built-in modules.\\n' +\x0d\n      'To load a module from disk after the single executable application is ' +\x0d\n      'launched\x2C use require("module").createRequire().\\n' +\x0d\n      'Support for bundled module loading or virtual file systems are under ' +\x0d\n      'discussions in https://github.com/nodejs/single-executable');\x0d\n    warnedAboutBuiltins = true;\x0d\n  }\x0d\n  throw new ERR_UNKNOWN_BUILTIN_MODULE(id);\x0d\n}\x0d\n\x0d\n/** @type {Module} */\x0d\nlet $Module = null;\x0d\n/**\x0d\n * Import the Module class on first use.\x0d\n * @returns {object}\x0d\n */\x0d\nfunction lazyModule() {\x0d\n  return $Module ??= require('internal/modules/cjs/loader').Module;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Create the module-scoped `require` function to pass into CommonJS modules.\x0d\n * @param {Module} mod - The module to create the `require` function for.\x0d\n * @returns {function(string): unknown}\x0d\n */\x0d\nfunction makeRequireFunction(mod) {\x0d\n  // lazy due to cycle\x0d\n  const Module = lazyModule();\x0d\n  if (mod instanceof Module !== true) {\x0d\n    throw new ERR_INVALID_ARG_TYPE('mod'\x2C 'Module'\x2C mod);\x0d\n  }\x0d\n\x0d\n  function require(path) {\x0d\n    return mod.require(path);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * The `resolve` method that gets attached to module-scope `require`.\x0d\n   * @param {string} request\x0d\n   * @param {Parameters<Module['_resolveFilename']>[3]} options\x0d\n   * @returns {string}\x0d\n   */\x0d\n  function resolve(request\x2C options) {\x0d\n    validateString(request\x2C 'request');\x0d\n    const { resolveForCJSWithHooks } = lazyCJSLoader();\x0d\n    // require.resolve() has different behaviors from the internal resolution used by\x0d\n    // Module._load:\x0d\n    // 1. When the request resolves to a non-existent built-in\x2C it throws MODULE_NOT_FOUND\x0d\n    //   instead of UNKNOWN_BUILTIN_MODULE. This is handled by resolveForCJSWithHooks.\x0d\n    // 2. If the request is a prefixed built-in\x2C the returned value is also prefixed. This\x0d\n    //   is handled below.\x0d\n    const { filename\x2C url } = resolveForCJSWithHooks(\x0d\n      request\x2C mod\x2C /* isMain */ false\x2C {\x0d\n        __proto__: null\x2C\x0d\n        shouldSkipModuleHooks: false\x2C\x0d\n        requireResolveOptions: options ?? {}\x2C\x0d\n      });\x0d\n    if (url === request && StringPrototypeStartsWith(request\x2C 'node:')) {\x0d\n      return url;\x0d\n    }\x0d\n    return filename;\x0d\n  }\x0d\n\x0d\n  require.resolve = resolve;\x0d\n\x0d\n  /**\x0d\n   * The `paths` method that gets attached to module-scope `require`.\x0d\n   * @param {string} request\x0d\n   * @returns {object}\x0d\n   */\x0d\n  function paths(request) {\x0d\n    validateString(request\x2C 'request');\x0d\n    return Module._resolveLookupPaths(request\x2C mod);\x0d\n  }\x0d\n\x0d\n  resolve.paths = paths;\x0d\n\x0d\n  setOwnProperty(require\x2C 'main'\x2C process.mainModule);\x0d\n\x0d\n  // Enable support to add extra extension types.\x0d\n  require.extensions = Module._extensions;\x0d\n\x0d\n  require.cache = Module._cache;\x0d\n\x0d\n  return require;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Remove byte order marker. This catches EF BB BF (the UTF-8 BOM)\x0d\n * because the buffer-to-string conversion in `fs.readFileSync()`\x0d\n * translates it to FEFF\x2C the UTF-16 BOM.\x0d\n * @param {string} content\x0d\n * @returns {string}\x0d\n */\x0d\nfunction stripBOM(content) {\x0d\n  if (StringPrototypeCharCodeAt(content) === 0xFEFF) {\x0d\n    content = StringPrototypeSlice(content\x2C 1);\x0d\n  }\x0d\n  return content;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Add built-in modules to a global or REPL scope object.\x0d\n * @param {Record<string\x2C unknown>} object - The object such as `globalThis` to add the built-in modules to.\x0d\n * @param {string} dummyModuleName - The label representing the set of built-in modules to add.\x0d\n */\x0d\nfunction addBuiltinLibsToObject(object\x2C dummyModuleName) {\x0d\n  // Make built-in modules available directly (loaded lazily).\x0d\n  const Module = require('internal/modules/cjs/loader').Module;\x0d\n  const { builtinModules } = Module;\x0d\n\x0d\n  // To require built-in modules in user-land and ignore modules whose\x0d\n  // `canBeRequiredByUsers` is false. So we create a dummy module object and not\x0d\n  // use `require()` directly.\x0d\n  const dummyModule = new Module(dummyModuleName);\x0d\n\x0d\n  ArrayPrototypeForEach(builtinModules\x2C (name) => {\x0d\n    // Neither add underscored modules\x2C nor ones that contain slashes (e.g.\x2C\x0d\n    // 'fs/promises') or ones that are already defined.\x0d\n    if (name[0] === '_' ||\x0d\n        StringPrototypeIncludes(name\x2C '/') ||\x0d\n        ObjectPrototypeHasOwnProperty(object\x2C name)) {\x0d\n      return;\x0d\n    }\x0d\n    // Goals of this mechanism are:\x0d\n    // - Lazy loading of built-in modules\x0d\n    // - Having all built-in modules available as non-enumerable properties\x0d\n    // - Allowing the user to re-assign these variables as if there were no\x0d\n    //   pre-existing globals with the same name.\x0d\n\x0d\n    const setReal = (val) => {\x0d\n      // Deleting the property before re-assigning it disables the\x0d\n      // getter/setter mechanism.\x0d\n      delete object[name];\x0d\n      object[name] = val;\x0d\n    };\x0d\n\x0d\n    ObjectDefineProperty(object\x2C name\x2C {\x0d\n      __proto__: null\x2C\x0d\n      get: () => {\x0d\n        const lib = dummyModule.require(name);\x0d\n\x0d\n        try {\x0d\n          // Override the current getter/setter and set up a new\x0d\n          // non-enumerable property.\x0d\n          ObjectDefineProperty(object\x2C name\x2C {\x0d\n            __proto__: null\x2C\x0d\n            get: () => lib\x2C\x0d\n            set: setReal\x2C\x0d\n            configurable: true\x2C\x0d\n            enumerable: false\x2C\x0d\n          });\x0d\n        } catch {\x0d\n          // If the property is no longer configurable\x2C ignore the error.\x0d\n        }\x0d\n\x0d\n        return lib;\x0d\n      }\x2C\x0d\n      set: setReal\x2C\x0d\n      configurable: true\x2C\x0d\n      enumerable: false\x2C\x0d\n    });\x0d\n  });\x0d\n}\x0d\n\x0d\n/**\x0d\n * Normalize the referrer name as a URL.\x0d\n * If it's a string containing an absolute path or a URL it's normalized as\x0d\n * a URL string.\x0d\n * Otherwise it's returned as undefined.\x0d\n * @param {string | null | undefined} referrerName\x0d\n * @returns {string | undefined}\x0d\n */\x0d\nfunction normalizeReferrerURL(referrerName) {\x0d\n  if (referrerName === null || referrerName === undefined) {\x0d\n    return undefined;\x0d\n  }\x0d\n\x0d\n  if (typeof referrerName === 'string') {\x0d\n    if (path.isAbsolute(referrerName)) {\x0d\n      return pathToFileURL(referrerName).href;\x0d\n    }\x0d\n\x0d\n    if (StringPrototypeStartsWith(referrerName\x2C 'file://') ||\x0d\n    URLCanParse(referrerName)) {\x0d\n      return referrerName;\x0d\n    }\x0d\n\x0d\n    return undefined;\x0d\n  }\x0d\n\x0d\n  assert.fail('Unreachable code reached by ' + inspect(referrerName));\x0d\n}\x0d\n\x0d\n/**\x0d\n * Coerce a URL string to a filename. This is used by the ESM loader\x0d\n * to map ESM URLs to entries in the CJS module cache on a best-effort basis.\x0d\n * TODO(joyeecheung): this can be rather expensive\x2C cache the result on the\x0d\n * ModuleWrap wherever we can.\x0d\n * @param {string|undefined} url URL to convert to filename\x0d\n * @returns {string|undefined}\x0d\n */\x0d\nfunction urlToFilename(url) {\x0d\n  if (url && StringPrototypeStartsWith(url\x2C 'file://')) {\x0d\n    let urlObj;\x0d\n    try {\x0d\n      urlObj = new URL(url);\x0d\n    } catch {\x0d\n      // Not a proper URL\x2C return as-is as the cache key.\x0d\n      return url;\x0d\n    }\x0d\n    try {\x0d\n      return fileURLToPath(urlObj);\x0d\n    } catch {\x0d\n      // This is generally only possible when the URL is provided by a custom loader.\x0d\n      // Just use the path and ignore whether it's absolute or not as there's no such\x0d\n      // requirement for CJS cache.\x0d\n      return urlObj.pathname;\x0d\n    }\x0d\n  }\x0d\n  // Not a file URL\x2C return as-is.\x0d\n  return url;\x0d\n}\x0d\n\x0d\n// Whether we have started executing any user-provided CJS code.\x0d\n// This is set right before we call the wrapped CJS code (not after\x2C\x0d\n// in case we are half-way in the execution when internals check this).\x0d\n// Used for internal assertions.\x0d\nlet _hasStartedUserCJSExecution = false;\x0d\n// Similar to _hasStartedUserCJSExecution but for ESM. This is set\x0d\n// right before ESM evaluation in the default ESM loader. We do not\x0d\n// update this during vm SourceTextModule execution because at that point\x0d\n// some user code must already have been run to execute code via vm\x0d\n// there is little value checking whether any user JS code is run anyway.\x0d\nlet _hasStartedUserESMExecution = false;\x0d\n\x0d\n/**\x0d\n * Load a public built-in module. ID may or may not be prefixed by `node:` and\x0d\n * will be normalized.\x0d\n * @param {string} id ID of the built-in to be loaded.\x0d\n * @returns {object|undefined} exports of the built-in. Undefined if the built-in\x0d\n *   does not exist.\x0d\n */\x0d\nfunction getBuiltinModule(id) {\x0d\n  validateString(id\x2C 'id');\x0d\n  const normalizedId = BuiltinModule.normalizeRequirableId(id);\x0d\n  return normalizedId ? require(normalizedId) : undefined;\x0d\n}\x0d\n\x0d\n/** @type {import('internal/util/types')} */\x0d\nlet _TYPES = null;\x0d\n/**\x0d\n * Lazily loads and returns the internal/util/types module.\x0d\n * @returns {object}\x0d\n */\x0d\nfunction lazyTypes() {\x0d\n  if (_TYPES !== null) { return _TYPES; }\x0d\n  return _TYPES = require('internal/util/types');\x0d\n}\x0d\n\x0d\n\x0d\n/**\x0d\n * Asserts that the given body is a buffer source (either a string\x2C array buffer\x2C or typed array).\x0d\n * Throws an error if the body is not a buffer source.\x0d\n * @param {string | ArrayBufferView | ArrayBuffer} body - The body to check.\x0d\n * @param {boolean} allowString - Whether or not to allow a string as a valid buffer source.\x0d\n * @param {string} hookName - The name of the hook being called.\x0d\n * @throws {ERR_INVALID_RETURN_PROPERTY_VALUE} If the body is not a b