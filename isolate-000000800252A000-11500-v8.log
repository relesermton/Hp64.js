x0d\n        format = undefined;\x0d\n        break;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  let compiledWrapper;\x0d\n  if (format !== 'module') {\x0d\n    const result = wrapSafe(filename\x2C content\x2C this\x2C format);\x0d\n    compiledWrapper = result.function;\x0d\n    if (result.canParseAsESM) {\x0d\n      format = 'module';\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (format === 'module') {\x0d\n    loadESMFromCJS(this\x2C filename\x2C format\x2C content);\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const dirname = path.dirname(filename);\x0d\n  const require = makeRequireFunction(this);\x0d\n  let result;\x0d\n  const exports = this.exports;\x0d\n  const thisValue = exports;\x0d\n  const module = this;\x0d\n  if (requireDepth === 0) { statCache = new SafeMap(); }\x0d\n  setHasStartedUserCJSExecution();\x0d\n  this[kIsExecuting] = true;\x0d\n  if (this[kIsMainSymbol] && getOptionValue('--inspect-brk')) {\x0d\n    const { callAndPauseOnStart } = internalBinding('inspector');\x0d\n    result = callAndPauseOnStart(compiledWrapper\x2C thisValue\x2C exports\x2C\x0d\n                                 require\x2C module\x2C filename\x2C dirname);\x0d\n  } else {\x0d\n    result = FunctionPrototypeCall(compiledWrapper\x2C thisValue\x2C exports\x2C require\x2C module\x2C filename\x2C dirname);\x0d\n  }\x0d\n  this[kIsExecuting] = false;\x0d\n  if (requireDepth === 0) { statCache = null; }\x0d\n  return result;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Get the source code of a module\x2C using cached ones if it's cached. This is used\x0d\n * for TypeScript\x2C JavaScript and JSON loading.\x0d\n * After this returns\x2C mod[kFormat]\x2C mod[kModuleSource] and mod[kURL] will be set.\x0d\n * @param {Module} mod Module instance whose source is potentially already cached.\x0d\n * @param {string} filename Absolute path to the file of the module.\x0d\n * @returns {{source: string\x2C format?: string}}\x0d\n */\x0d\nfunction loadSource(mod\x2C filename\x2C formatFromNode) {\x0d\n  if (mod[kFormat] === unde