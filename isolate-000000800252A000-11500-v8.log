script-source,88,node:internal/main/eval_string,'use strict';\x0d\n\x0d\n// User passed `-e` or `--eval` arguments to Node without `-i` or\x0d\n// `--interactive`.\x0d\n\x0d\nconst {\x0d\n  ObjectDefineProperty\x2C\x0d\n  RegExpPrototypeExec\x2C\x0d\n  globalThis\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  prepareMainThreadExecution\x2C\x0d\n  markBootstrapComplete\x2C\x0d\n} = require('internal/process/pre_execution');\x0d\nconst {\x0d\n  evalModuleEntryPoint\x2C\x0d\n  evalTypeScript\x2C\x0d\n  parseAndEvalCommonjsTypeScript\x2C\x0d\n  parseAndEvalModuleTypeScript\x2C\x0d\n  evalScript\x2C\x0d\n} = require('internal/process/execution');\x0d\nconst { addBuiltinLibsToObject } = require('internal/modules/helpers');\x0d\nconst { getOptionValue } = require('internal/options');\x0d\n\x0d\nprepareMainThreadExecution();\x0d\naddBuiltinLibsToObject(globalThis\x2C '<eval>');\x0d\nmarkBootstrapComplete();\x0d\n\x0d\nconst code = getOptionValue('--eval');\x0d\n\x0d\nconst print = getOptionValue('--print');\x0d\nconst shouldLoadESM = getOptionValue('--import').length > 0 || getOptionValue('--experimental-loader').length > 0;\x0d\nconst inputType = getOptionValue('--input-type');\x0d\nconst tsEnabled = getOptionValue('--strip-types');\x0d\nif (inputType === 'module') {\x0d\n  evalModuleEntryPoint(code\x2C print);\x0d\n} else if (inputType === 'module-typescript' && tsEnabled) {\x0d\n  parseAndEvalModuleTypeScript(code\x2C print);\x0d\n} else {\x0d\n  // For backward compatibility\x2C we want the identifier crypto to be the\x0d\n  // `node:crypto` module rather than WebCrypto.\x0d\n  const isUsingCryptoIdentifier = RegExpPrototypeExec(/\\bcrypto\\b/\x2C code) !== null;\x0d\n  const shouldDefineCrypto = isUsingCryptoIdentifier && internalBinding('config').hasOpenSSL;\x0d\n\x0d\n  if (isUsingCryptoIdentifier && !shouldDefineCrypto) {\x0d\n    // This is taken from `addBuiltinLibsToObject`.\x0d\n    const object = globalThis;\x0d\n    const name = 'crypto';\x0d\n    const setReal = (val) => {\x0d\n      // Deleting the property before re-assigning it disables the\x0d\n      // getter/setter mechanism.\x0d\n      delete object[name];\x0d\n      object[name] = val;\x0d\n    };\x0d\n    ObjectDefineProperty(object\x2C name\x2C { __proto__: null\x2C set: setReal });\x0d\n  }\x0d\n\x0d\n  let evalFunction;\x0d\n  if (inputType === 'commonjs') {\x0d\n    evalFunction = evalScript;\x0d\n  } else if (inputType === 'commonjs-typescript' && tsEnabled) {\x0d\n    evalFunction = parseAndEvalCommonjsTypeScript;\x0d\n  } else if (tsEnabled) {\x0d\n    evalFunction = evalTypeScript;\x0d\n  } else {\x0d\n    // Default to commonjs.\x0d\n    evalFunction = evalScript;\x0d\n  }\x0d\n\x0d\n  evalFunction('[eval]'\x2C\x0d\n               shouldDefineCrypto ? (\x0d\n                 print ? `let crypto=require("node:crypto");{${code}}` : `(crypto=>{{${code}}})(require('node:crypto'))`\x0d\n               ) : code\x2C\x0d\n               getOptionValue('--inspect-brk')\x2C\x0d\n               print\x2C\x0d\n               shouldLoadESM);\x0d\n}\x0d\n
